# API y SQL Server. Sustituir valores en un archivo .env local no versionado.
BDSERVIDOR=localhost
BDPUERTO=1433
BDNOMBRE=ParqueErickBarrondo
BDUSUARIO=parqueaplicacion
BDCONTRASENA=CambiarSoloEnLocal123
BDUSUARIOMIGRACION=parquemigrador
BDCONTRASENAMIGRACION=CambiarSoloEnLocal123
BDCIFRAR=true
# Solo para el certificado autofirmado del desarrollo local; en producción usar false y un certificado válido.
BDCONFIARCERTIFICADOSERVIDOR=true

# Almacenamiento persistente fuera del ejecutable.
ALMACENAMIENTORUTAPUBLICACIONES=../datos/publicaciones
ALMACENAMIENTORUTAEVENTOS=../datos/eventos
ALMACENAMIENTORUTAAREAS=../datos/areas
ALMACENAMIENTORUTAPERFILES=../datos/perfiles

# Solo variables públicas pueden comenzar con VITE_. Este prefijo es obligatorio en Vite.
VITE_URLBASEAPI=/api/v1
# Servicio peatonal usado para dibujar recorridos desde la ubicación GPS.
VITE_URLSERVICIORUTASPEATONALES=https://valhalla1.openstreetmap.de/route

# Seguridad local. Cambiar la clave de huellas antes de usar otro ambiente.
SEGURIDADCLAVEHUELLAS=REEMPLAZARCONUNACLAVEALEATORIADE32BYTES
SEGURIDADMAXIMOINTENTOS=5
SEGURIDADVENTANAMINUTOS=15
SEGURIDADLONGITUDMINIMACONTRASENA=12

# Creación opcional y única del primer administrador local.
ADMININICIALHABILITADO=false
ADMININICIALCORREO=
ADMININICIALNOMBRE=
ADMININICIALAPELLIDO=
ADMININICIALCONTRASENA=

# En un ambiente final se activa el perfil "produccion" desde la configuración externa:
# SPRING_PROFILES_ACTIVE=produccion

# Verificación de cuentas por Gmail SMTP. En producción estas variables son obligatorias.
CORREOENVIOHABILITADO=true
CORREOPROBARCONEXIONALINICIAR=true
CORREOSMTPHOST=smtp.gmail.com
CORREOSMTPPUERTO=587
CORREONOREPLY=notific.parqueerickbarrondo@gmail.com
CORREOCLAVEAPLICACION=REEMPLAZAR_CON_CONTRASENA_DE_APLICACION
# Dominio público estable. Los túneles temporales trycloudflare.com se detectan por solicitud.
URLPUBLICAFRONTEND=https://parque.ejemplo.gob.gt
